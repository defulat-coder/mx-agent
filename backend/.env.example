# API
API_PREFIX=/v1
APP_NAME=马喜智能助手
DEBUG=false
AGENTOS_ID=
AGENTOS_NAME=mx-agent
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=sqlite+aiosqlite:///data/mx_agent.db

# LLM
LLM_MODEL=GLM-4.7
LLM_API_KEY=your-zhipu-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# Auth
AUTH_SECRET=replace-with-at-least-32-random-bytes
ALLOW_MOCK_IDENTITY=false

# Langfuse
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=log/mx-agent.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days
